bin/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Environment Variables & Secrets
.env
.env.*
!.env.example

# Local Data Cache (Prevents committing raw scraped JSONs to Git)
data/
*.json
*.csv
*.sqlite3
output/
backend/output/chats/images/metadata/network/pages/pdfs/tables

# Logs (Ignore all standard Python, pip, and execution log files)
*.log
logs/
*.log.*
pip-log.txt
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.system_generated/logs/

# IDEs and editors
.vscode/
.idea/
*.suo
